# Copie ce fichier en ".env" puis remplis-le. Le fichier .env n'est jamais envoyé sur GitHub.

# "local" = Ollama sur ton Mac / "api" = Groq + fastembed (version en ligne)
LLM_MODE=local

# Ta clé Groq (https://console.groq.com/keys). Nécessaire seulement en mode api.
GROQ_API_KEY=

# Base de données Supabase (obligatoire) : Project Settings > Database > Connection string,
# onglet « Session pooler ». Remplace [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.htxtgnyffgjiloqyanoa:s3XbTghXT1diYYDR@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# Options (les valeurs par défaut conviennent, décommente pour changer)
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=bge-m3
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant

# Mot de passe de l'onglet Admin (lire les signalements et avis des testeurs).
# Laisse vide pour désactiver l'onglet. Choisis un mot de passe long et unique.
ADMIN_PASSWORD=

# Copie des signalements et avis sur Telegram (optionnel, recommandé en ligne)
# Token donné par @BotFather, puis chat_id avec : python test_telegram.py --chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
